{
  "integration_name": "payroll_nz",
  "auth_type": "xero_oauth2",
  "auth_config": {
    "token_source": "authorization_code_refresh",
    "client_id_env_var": "XERO_CLIENT_ID",
    "client_secret_env_var": "XERO_CLIENT_SECRET",
    "token_url": "https://identity.xero.com/connect/token",
    "authorization_url": "https://identity.xero.com/connect/authorize",
    "access_token_expiry": 1800,
    "refresh_token_expiry": 5184000,
    "grant_type": "authorization_code",
    "redirect_uri": "https://etani.com/oauth/callback",
    "scopes": [
      "openid",
      "practicemanager",
      "offline_access"
    ],
    "additional_params": {
      "response_type": "code"
    },
    "custom_headers": {
      "Content-Type": "application/json",
      "Xero-tenant-id": "{tenant_id}"
    }
  },
  "required_env_vars": [
    "EtaniClientID",
    "EtaniOrganisationID",
    "XERO_CLIENT_ID",
    "XERO_CLIENT_SECRET",
    "XeroTenantID"
  ],
  "env_var_validations": {
    "EtaniClientID": "lambda x: 'CLIENT' in x",
    "XERO_CLIENT_ID": "lambda x: len(x) == 32 and x.isalnum()",
    "XERO_CLIENT_SECRET": "",
    "XERO_REFRESH_TOKEN": "",
    "XERO_ACCESS_TOKEN": "",
    "XeroTenantID": "lambda x: len(x) == 36 and '-' in x",
    "DB_Destination": "lambda x: x in ['EVA', 'CMS', 'DW']"
  },
  "env_vars_config": {
    "etani_client_id": {
      "env_var": "EtaniClientID",
      "default_value": ""
    },
    "etani_organisation_id": {
      "env_var": "EtaniOrganisationID",
      "default_value": ""
    },
    "xero_client_id": {
      "env_var": "XERO_CLIENT_ID",
      "default_value": "",
      "source": "AWS Secrets Manager (etani/xero/oauth-app)"
    },
    "xero_client_secret": {
      "env_var": "XERO_CLIENT_SECRET",
      "default_value": "",
      "source": "AWS Secrets Manager (etani/xero/oauth-app)"
    },
    "xero_access_token": {
      "env_var": "XERO_ACCESS_TOKEN",
      "default_value": ""
    },
    "xero_refresh_token": {
      "env_var": "XERO_REFRESH_TOKEN",
      "default_value": ""
    },
    "xero_tenant_id": {
      "env_var": "XeroTenantID",
      "default_value": ""
    },
    "storage_account_name": {
      "env_var": "STORAGE_ACCOUNT_NAME",
      "default_value": ""
    },
    "storage_access_key": {
      "env_var": "STORAGE_ACCESS_KEY",
      "default_value": ""
    },
    "file_share_name": {
      "env_var": "FILE_SHARE_NAME",
      "default_value": ""
    },
    "db_destination": {
      "env_var": "DB_Destination",
      "default_value": ""
    },
    "trigger_type": {
      "env_var": "TRIGGER_TYPE",
      "default_value": ""
    },
    "reset_mode": {
      "env_var": "Reset_Mode",
      "default_value": false
    }
  },
  "exclude_fields": [
    "ValidationErrors",
    "HasValidationErrors",
    "Warnings",
    "Meta",
    "Pagination",
    "_links",
    "_embedded",
    "Links",
    "Href"
  ],
  "exclude_endpoints": [
    "SystemInfo",
    "UserPreferences",
    "ActivityLogs",
    "AuditTrail",
    "Files",
    "Documents",
    "Attachments",
    "Notes",
    "Comments",
    "Debug",
    "Health",
    "Metadata"
  ]
}
