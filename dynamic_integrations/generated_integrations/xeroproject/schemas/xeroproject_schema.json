        "burst_limit": 60,
        "daily_limit": 5000
      }
    },
    "rate_limiting": {
      "requests_per_minute": 60,
      "burst_limit": 60,
      "daily_limit": 5000,
      "concurrent_limit": 5,
      "window_seconds": 60,
      "description": "60 requests per minute, 5,000 requests per day, maximum 5 concurrent requests. If exceeded, returns 429 Too Many Requests with Retry-After header."
    },
    "url_patterns": {
      "has_company_id": false,
      "has_realm_id": false,
      "has_tenant_id": true,
      "entity_endpoint": "/{EntityName}",
      "url_template_vars": [
        "page",
        "pageSize"
      ],
      "requires_trailing_slash": false
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer {{xero_access_token}}",
      "Xero-tenant-id": "{{xero_tenant_id}}",
      "User-Agent": "Etani-XeroProjects-Integration/1.0"
    },
    "pagination": {
      "type": "page_based",
      "limit_param": "pageSize",
      "offset_param": "page",
      "default_limit": 100,
      "max_limit": 100
    },
    "response_wrapper": {
      "data_key": null,
      "meta_key": null,
      "pagination_key": null,
      "direct_array": true
    }
  },
